# End caps beside a doorway or a wall end.
@frame wall/face-hi-l from=wall/face-hi edgeL=T
@frame wall/face-hi-r from=wall/face-hi edgeR=T
@frame wall/face-lo-l from=wall/face-lo edgeL=T
@frame wall/face-lo-r from=wall/face-lo edgeR=T

