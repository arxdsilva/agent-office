# ── n (away from the viewer): mostly the s silhouettes; forward reaches hide the hands ───────────
@frame arms-down-n from=arms-down-s
@frame arms-swing-a-n from=arms-swing-a-s
@frame arms-swing-b-n from=arms-swing-a-s flip=x
@frame arms-type-a-n
@meta {"hand":[8,4]}
................
................
..oo........oo..
.oDE........EFo.
.oDEo......oEFo.
..oo........oo..

@frame arms-type-b-n
@meta {"hand":[8,4]}
................
................
..oo........oo..
.oDE........EFo.
..oEo......oEFo.
...o........oo..

@frame arms-lap-n from=arms-type-a-n
@frame arms-chin-n from=arms-type-a-n
@frame arms-hold-n from=arms-type-a-n
@frame arms-gesture-n from=arms-gesture-s
@frame arms-phone-n from=arms-phone-s
@frame arms-up-a-n from=arms-up-a-s
@frame arms-up-b-n from=arms-up-b-s
@frame arms-scratch-a-n from=arms-scratch-a-s
@frame arms-scratch-b-n from=arms-scratch-b-s
@frame arms-out-n from=arms-out-s
@frame arms-paddle-b-n from=arms-paddle-b-s

