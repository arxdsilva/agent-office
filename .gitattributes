# Binary 3D assets are stored with Git LFS (brew install git-lfs && git lfs install).
# Generated by `make assets`; never edited by hand. See README → Building the assets.
packages/web/public/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
packages/web/public/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
packages/web/public/assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets/out/** filter=lfs diff=lfs merge=lfs -text
assets/previews/** filter=lfs diff=lfs merge=lfs -text
