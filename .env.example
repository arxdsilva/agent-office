# Environment overrides for development and tests. User-facing values live in the app's Settings;
# these win for the current run only.
PORT=4317                     # local HTTP API port (hook + external agents)
HOST=127.0.0.1                # bind address; never 0.0.0.0 without ALLOWED_HOSTS and an auth proxy
ALLOWED_HOSTS=                # extra host:port values accepted by the Host check
AGENT_OFFICE_HOME=~/.agent-office          # token directory (shared with the hook)
CLAUDE_PROJECTS_DIR=~/.claude/projects     # Claude Code transcripts
CLAUDE_SETTINGS_FILE=~/.claude/settings.json
AGENT_OFFICE_CLAUDE=1         # 0 disables the Claude Code adapter
AGENT_OFFICE_MOCK=0           # 1 adds simulated agents
AGENT_OFFICE_USER_DATA=       # separate app profile (tests, side-by-side dev)
IDLE_AFTER_MS=60000
EXPIRE_AFTER_MS=600000
