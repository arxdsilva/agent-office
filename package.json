{
  "name": "agent-office",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-office/desktop dev",
    "dev:mock": "AGENT_OFFICE_MOCK=1 pnpm --filter @agent-office/desktop dev",
    "build": "pnpm --filter @agent-office/desktop build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "vitest run --project e2e",
    "coverage": "vitest run --project unit --coverage",
    "test:ui": "pnpm --filter @agent-office/desktop test:ui",
    "arch": "node scripts/arch.mjs",
    "package": "pnpm --filter @agent-office/desktop package",
    "package:dist": "pnpm --filter @agent-office/desktop package:dist",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@agent-office/adapters": "workspace:*",
    "@agent-office/core": "workspace:*",
    "@agent-office/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
