{
  "name": "agent-office",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/web dev",
    "dev:mock": "AGENT_OFFICE_MOCK=1 pnpm dev",
    "build": "pnpm --filter ./packages/web build",
    "start": "pnpm --filter ./packages/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "vitest run --project e2e",
    "coverage": "vitest run --project unit --coverage",
    "test:ui": "pnpm --filter @agent-office/web test:ui"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
